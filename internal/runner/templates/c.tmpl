#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    static char buf[1 << 20];
    size_t n = fread(buf, 1, sizeof buf - 1, stdin);
    buf[n] = '\0';

    /* your solution here */
    fputs(buf, stdout);
    return 0;
}
